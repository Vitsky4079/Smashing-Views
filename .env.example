# ---------- Public (safe for the browser) ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Leave empty until real details are available — empty values are hidden on the site.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_ADDRESS=
NEXT_PUBLIC_COMPANY_LEGAL_NAME=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_TIKTOK=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
# Cloudflare Turnstile public site key (optional spam protection)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---------- Contact form delivery (server only) — configure ONE provider ----------
# Option A: Resend (https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
# Option B: Formspree endpoint, e.g. https://formspree.io/f/<form-id>
FORMSPREE_ENDPOINT=
# Turnstile secret (optional; if set, tokens are verified server-side)
TURNSTILE_SECRET_KEY=

# ---------- LivePanel supplier integration (server only, optional) ----------
# Leave LIVEPANEL_API_KEY empty to keep the site a pure marketing/inquiry site.
LIVEPANEL_API_URL=https://livepanel.pro/api/v1
LIVEPANEL_API_KEY=
# Enables the read-only admin catalog endpoint. Use a long random value.
ADMIN_API_TOKEN=
# Must stay "false" until an authenticated, payment-confirmed order workflow exists.
LIVEPANEL_ORDERS_ENABLED=false
